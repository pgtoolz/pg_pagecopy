ARG SOURCE_PG_VERSION=17
ARG TARGET_PG_VERSION=18
ARG EXTENSION_TAG=dev

FROM rust:1.99-bookworm AS build
RUN rustup component add clippy
WORKDIR /work
COPY tests/bdd/Cargo.toml tests/bdd/Cargo.lock ./
# Stub binary: prebuild dependencies in the release profile (plain and clippy
# fingerprints) so later harness changes recompile only this crate; real
# sources overwrite the stub.
RUN echo 'fn main() {}' > main.rs \
    && cargo build --release --locked \
    && cargo clippy --release --locked -- -D warnings -D clippy::pedantic
COPY tests/bdd/main.rs tests/bdd/postgres.rs tests/bdd/steps.rs tests/bdd/world.rs ./
# Host mtimes survive COPY; without the touch cargo keeps the stub binary.
RUN touch main.rs postgres.rs steps.rs world.rs \
    && cargo clippy --release --all-targets --locked -- -D warnings -D clippy::pedantic \
    && cargo test --release --locked \
    && cargo build --release --locked

FROM pg-pagecopy-pg${SOURCE_PG_VERSION}:${EXTENSION_TAG} AS extension_source

FROM postgres:${SOURCE_PG_VERSION}-bookworm AS fixtures_source
ARG SOURCE_PG_VERSION
RUN apt-get update \
    && apt-get install -y --no-install-recommends gcc postgresql-server-dev-${SOURCE_PG_VERSION} \
    && rm -rf /var/lib/apt/lists/*
COPY tests/bdd/fixtures.c /tmp/fixtures.c
RUN cc -shared -fPIC -Wall -Werror \
    -I"$(/usr/lib/postgresql/${SOURCE_PG_VERSION}/bin/pg_config --includedir-server)" \
    /tmp/fixtures.c -o /tmp/pc_bdd_fixtures.so

FROM postgres:${TARGET_PG_VERSION}-bookworm AS fixtures_target
ARG TARGET_PG_VERSION
RUN apt-get update \
    && apt-get install -y --no-install-recommends gcc postgresql-server-dev-${TARGET_PG_VERSION} \
    && rm -rf /var/lib/apt/lists/*
COPY tests/bdd/fixtures.c /tmp/fixtures.c
RUN cc -shared -fPIC -Wall -Werror \
    -I"$(/usr/lib/postgresql/${TARGET_PG_VERSION}/bin/pg_config --includedir-server)" \
    /tmp/fixtures.c -o /tmp/pc_bdd_fixtures.so

FROM pg-pagecopy-pg${TARGET_PG_VERSION}:${EXTENSION_TAG}
ARG SOURCE_PG_VERSION
ARG TARGET_PG_VERSION
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       postgresql-${SOURCE_PG_VERSION} postgresql-${TARGET_PG_VERSION} \
       postgresql-contrib-${SOURCE_PG_VERSION} postgresql-contrib-${TARGET_PG_VERSION} \
    && rm -rf /var/lib/apt/lists/*
COPY --from=extension_source /usr/lib/postgresql/${SOURCE_PG_VERSION}/lib/pg_pagecopy.so /usr/lib/postgresql/${SOURCE_PG_VERSION}/lib/pg_pagecopy.so
COPY --from=extension_source /usr/share/postgresql/${SOURCE_PG_VERSION}/extension/pg_pagecopy* /usr/share/postgresql/${SOURCE_PG_VERSION}/extension/
COPY --from=fixtures_source /tmp/pc_bdd_fixtures.so /usr/lib/postgresql/${SOURCE_PG_VERSION}/lib/
COPY --from=fixtures_target /tmp/pc_bdd_fixtures.so /usr/lib/postgresql/${TARGET_PG_VERSION}/lib/
COPY --from=build /work/target/release/pg-pagecopy-bdd /usr/local/bin/pg-pagecopy-bdd
COPY tests/bdd/cross-features /opt/pg-pagecopy-bdd/cross-features
ENV PG_VERSION=${TARGET_PG_VERSION} \
    PG_PAGECOPY_SOURCE_MAJOR=${SOURCE_PG_VERSION} \
    PG_PAGECOPY_TARGET_MAJOR=${TARGET_PG_VERSION} \
    PG_PAGECOPY_FEATURES=/opt/pg-pagecopy-bdd/cross-features
CMD ["pg-pagecopy-bdd"]
